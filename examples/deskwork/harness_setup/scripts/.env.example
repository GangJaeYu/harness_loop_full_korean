# Deskwork — 로컬 개발 환경 예시 환경변수
#
# 이 파일에는 **키 이름과 형식만** 둔다. 실제 값은 두지 않는다 (security.md §3.3, TD-013).
# 사용법: scripts/local-dev.ps1 이 이 파일을 저장소 루트의 .env.local 로 복사한다.
#         복사된 파일의 빈 값을 채운다. .env.local 은 저장소에 커밋하지 않는다.
#
# 값이 비어 있으면 local-dev.ps1 이 '2. 환경변수 준비' 단계에서 키 이름을 나열하고 멈춘다.

# ── 비밀값 (반드시 채운다. 값을 여기에 적지 않는다) ─────────────────────────
# 형식: postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=
# 형식: 32바이트 이상 난수의 base64 문자열. 세션·토큰 생성에 쓰는 서버 키
SESSION_SECRET=
# 형식: 32바이트 이상 난수의 base64 문자열. 정기 작업 호출용 공유 비밀값 (backend.md §3.13)
JOB_SHARED_SECRET=
# 형식: 제공자가 발급한 API 키. 로컬에서는 비워 둔다 (로컬은 메일 캡처로 보낸다, TD-009 잠정)
MAIL_PROVIDER_API_KEY=

# ── PostgreSQL (컨테이너) ────────────────────────────────────────────────────
POSTGRES_USER=deskwork
# 형식: 임의 문자열. 로컬 전용이며 운영 값과 같게 두지 않는다
POSTGRES_PASSWORD=
POSTGRES_DB=deskwork_dev
POSTGRES_PORT=5432

# ── 메일 수신함 캡처 (컨테이너) ──────────────────────────────────────────────
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_WEB_PORT=8025
# 형식: 이메일 주소. 발신자로 쓴다
MAIL_FROM=

# ── 애플리케이션 (호스트 실행) ───────────────────────────────────────────────
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# ── 로컬 개발 스크립트 전용 (포트·이름을 스크립트에 박지 않기 위한 것) ───────
# 여러 에이전트가 동시에 도는 경우 이 값들을 워크트리마다 다르게 준다.
# 실제 격리 방식은 loop-setup(Layer 5)이 정한다 — 하네스는 값을 밖에서 읽게만 해 둔다.
LOCALDEV_PG_CONTAINER=deskwork-postgres
LOCALDEV_PG_IMAGE=postgres:16-alpine
LOCALDEV_PG_VOLUME=deskwork-pgdata
LOCALDEV_MAIL_CONTAINER=deskwork-mailpit
LOCALDEV_MAIL_IMAGE=axllent/mailpit:latest
